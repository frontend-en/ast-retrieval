# OpenAI — embeddings для vector-db.js и retrieval API
OPENAI_API_KEY=sk-...

# Qdrant (локально: http://localhost:6333, prod: Qdrant Cloud URL)
QDRANT_URL=https://2ac66843-e413-47ff-b363-041cd86b2ea9.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-api-key-here
QDRANT_COLLECTION=code

# Neo4j — выключен по умолчанию (заглушка). Включить: NEO4J_ENABLED=true
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Vercel CLI (опционально, для локального деплоя)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
