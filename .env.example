# OpenAI — embeddings для vector-db.js и retrieval API
OPENAI_API_KEY=sk-...

# Qdrant (локально: http://localhost:6333, prod: Qdrant Cloud URL)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=code

# Neo4j (локально: bolt://localhost:7687, prod: Neo4j Aura URI)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Vercel CLI (опционально, для локального деплоя)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
